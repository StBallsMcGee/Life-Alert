# Copy to .env.local for development. Never commit real values.

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used for account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection (Project Settings -> Database -> Connection string, "Session pooler").
# Used by the NFL sync service and administrator corrections (one transaction per run).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Random long string. Schedulers must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=generate-a-long-random-string

# Public site URL (used in invitation links and auth emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NFL data provider: "mock" plays a sample postseason. A licensed provider is added in Phase 3.
NFL_DATA_PROVIDER=mock
